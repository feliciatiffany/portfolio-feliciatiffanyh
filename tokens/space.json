    "title-date": {
      "$type": "dimension",
      "$value": ".25em",
      "$description": "Title → date: tight, they read as one"
    },
    "date-sub": {
      "$type": "dimension",
      "$value": "1.25em",
      "$description": "Date → bold subtitle"
    },
    "sub-body": {
      "$type": "dimension",
      "$value": ".9em",
      "$description": "Subtitle → description"
    },
    "body-list": {
      "$type": "dimension",
      "$value": ".75em",
      "$description": "Description → bullet list"
    },
    "media-text": {
      "$type": "dimension",
      "$value": "clamp(28px, 11cqw, 52px)",
      "$description": "Image → title inside a card"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "clamp(12px, 1.6vw, 24px)",
      "$description": "Page gutter and grid gap"
    },
    "page-top": {
      "$type": "dimension",
      "$value": "clamp(24px, 3vw, 40px)",
      "$description": "Top of a page → its title"
    },
    "title-content": {
      "$type": "dimension",
      "$value": "clamp(36px, 5vw, 64px)",
      "$description": "Page title block (title, subtitle, meta) → the page content"
    },
    "section": {
      "$type": "dimension",
      "$value": "{space.8}",
      "$description": "Between sections of a page (each titled section also opens with a hairline)"
    },
    "group": {
      "$type": "dimension",
      "$value": "clamp(28px, 2.5vw, 48px)",
      "$description": "Between year groups on the timeline and blog"
    },
    "heading-content": {
      "$type": "dimension",
      "$value": "{space.3}",
      "$description": "A section heading → its content"
    },
    "caption-media": {
      "$type": "dimension",
      "$value": "{space.2}",
      "$description": "A caption or label → the image or video it describes"
    },
    "stack": {
      "$type": "dimension",
      "$value": "{space.4}",
      "$description": "Between items inside one section (text, images, videos)"
    },
    "paragraph": {
      "$type": "dimension",
      "$value": "1em",
      "$description": "Between paragraphs"
    },
    "rule-heading": {
      "$type": "dimension",
      "$value": "{space.8}",
      "$description": "Hairline at the top of a section → its heading"
    }
  }
}

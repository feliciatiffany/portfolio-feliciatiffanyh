{
  "font": {
    "family": {
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "Source Code Pro",
          "source-code-pro",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "Liberation Mono",
          "monospace"
        ],
        "$description": "Base. Typewriter face"
      },
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Montserrat",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Base. Clean sans"
      },
      "flex": {
        "$type": "fontFamily",
        "$value": [
          "Roboto Flex",
          "sans-serif"
        ],
        "$description": "Base. Variable font with a weight axis"
      },
      "title": {
        "$type": "fontFamily",
        "$value": "{font.family.mono}",
        "$description": "Titles, names, navigation, page default"
      },
      "body": {
        "$type": "fontFamily",
        "$value": "{font.family.sans}",
        "$description": "Captions, dates, descriptions, body copy"
      },
      "proximity": {
        "$type": "fontFamily",
        "$value": "{font.family.flex}",
        "$description": "Words that grow heavier near the cursor (About page)"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400,
        "$description": "Default text and big titles"
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500,
        "$description": "Labels and active filters"
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600,
        "$description": "Card titles"
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700,
        "$description": "Subtitles and small headings"
      }
    },
    "size": {
      "2xs": {
        "$type": "dimension",
        "$value": "11px",
        "$description": "Base step"
      },
      "xs": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "Base step"
      },
      "sm": {
        "$type": "dimension",
        "$value": "13px",
        "$description": "Base step"
      },
      "md": {
        "$type": "dimension",
        "$value": "14px",
        "$description": "Base step"
      },
      "base": {
        "$type": "dimension",
        "$value": "15px",
        "$description": "Base step"
      },
      "lg": {
        "$type": "dimension",
        "$value": "17px",
        "$description": "Base step"
      },
      "xl": {
        "$type": "dimension",
        "$value": "20px",
        "$description": "Base step"
      }
    }
  },
  "text": {
    "micro": {
      "$type": "dimension",
      "$value": "{font.size.2xs}",
      "$description": "Tiny labels under a details row"
    },
    "meta": {
      "$type": "dimension",
      "$value": "{font.size.xs}",
      "$description": "Dates, tags, footer, captions under media"
    },
    "ui": {
      "$type": "dimension",
      "$value": "{font.size.sm}",
      "$description": "Filters, small headings, form labels"
    },
    "body-sm": {
      "$type": "dimension",
      "$value": "{font.size.md}",
      "$description": "Summaries and secondary paragraphs"
    },
    "body": {
      "$type": "dimension",
      "$value": "{font.size.base}",
      "$description": "Reading text"
    },
    "body-lg": {
      "$type": "dimension",
      "$value": "{font.size.lg}",
      "$description": "Headings inside an article"
    },
    "heading-sm": {
      "$type": "dimension",
      "$value": "{font.size.xl}",
      "$description": "Small fixed headings"
    },
    "lead": {
      "$type": "dimension",
      "$value": "clamp(14px, 1.4vw, 17px)",
      "$description": "Fluid lead text and filter rows"
    },
    "small": {
      "$type": "dimension",
      "$value": "clamp(12px, 1vw, 14px)",
      "$description": "Fluid small text"
    },
    "subtitle": {
      "$type": "dimension",
      "$value": "clamp(16px, 1.6vw, 22px)",
      "$description": "Fluid subtitles under a page title"
    },
    "section-title": {
      "$type": "dimension",
      "$value": "clamp(20px, 2.4vw, 30px)",
      "$description": "Home intro, year headings, post titles in a list"
    },
    "page-title": {
      "$type": "dimension",
      "$value": "clamp(26px, 3.4vw, 40px)",
      "$description": "One per page: What I've done, Blog post, project title"
    },
    "intro-narrow": {
      "$type": "dimension",
      "$value": "clamp(18px, 5.4vw, 24px)",
      "$description": "Home intro on phones"
    },
    "hero": {
      "$type": "dimension",
      "$value": "clamp(18px, 4vw, 44px)",
      "$description": "Big hero line"
    },
    "nav": {
      "$type": "dimension",
      "$value": "clamp(18px, 1.6vw, 20px)",
      "$description": "Hero sub line and category links"
    },
    "footer": {
      "$type": "dimension",
      "$value": "clamp(14px, 1.5vw, 18px)",
      "$description": "Footer text links"
    },
    "list": {
      "$type": "dimension",
      "$value": "clamp(12px, 1.5vw, 16px)",
      "$description": "Resume and project list rows"
    },
    "card": {
      "title": {
        "$type": "dimension",
        "$value": "clamp(18px, 5.8cqw, 32px)",
        "$description": "Timeline card title (scales with the card)"
      },
      "sub": {
        "$type": "dimension",
        "$value": "clamp(13.5px, 3.75cqw, 19px)",
        "$description": "Timeline card bold subtitle"
      },
      "body": {
        "$type": "dimension",
        "$value": "clamp(13px, 3.5cqw, 17px)",
        "$description": "Timeline card date, description, bullets"
      },
      "title-sm": {
        "$type": "dimension",
        "$value": "clamp(15px, 4.2cqw, 21px)",
        "$description": "Creative Side card title"
      },
      "meta-sm": {
        "$type": "dimension",
        "$value": "clamp(12px, 3cqw, 15px)",
        "$description": "Creative Side card date"
      }
    }
  },
  "leading": {
    "none": {
      "$type": "number",
      "$value": 1,
      "$description": "Single-line controls and icons"
    },
    "tight": {
      "$type": "number",
      "$value": 1.15,
      "$description": "Base step"
    },
    "snug": {
      "$type": "number",
      "$value": 1.3,
      "$description": "Base step"
    },
    "normal": {
      "$type": "number",
      "$value": 1.45,
      "$description": "Base step"
    },
    "relaxed": {
      "$type": "number",
      "$value": 1.6,
      "$description": "Base step"
    },
    "loose": {
      "$type": "number",
      "$value": 1.75,
      "$description": "Base step"
    },
    "title": {
      "$type": "number",
      "$value": "{leading.tight}",
      "$description": "Every title and subtitle"
    },
    "body": {
      "$type": "number",
      "$value": "{leading.normal}",
      "$description": "Descriptions, captions, lists"
    },
    "prose": {
      "$type": "number",
      "$value": "{leading.relaxed}",
      "$description": "Long reading text (blog posts, project write-ups)"
    }
  }
}

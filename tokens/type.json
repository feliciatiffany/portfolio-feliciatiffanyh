{
  "font": {
    "family": {
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "Geist Mono Variable",
          "ui-monospace",
          "SF Mono",
          "Menlo",
          "monospace"
        ],
        "$description": "Base. Monospace: Geist Mono (bundled)"
      },
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "-apple-system",
          "BlinkMacSystemFont",
          "SF Pro Display",
          "SF Pro Text",
          "Inter Variable",
          "Inter",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Base. Clean sans: San Francisco on Apple devices, Inter (bundled) elsewhere"
      },
      "flex": {
        "$type": "fontFamily",
        "$value": [
          "Roboto Flex",
          "sans-serif"
        ],
        "$description": "Base. Variable font with a weight axis"
      },
      "title": {
        "$type": "fontFamily",
        "$value": "{font.family.sans}",
        "$description": "Titles, names, navigation, page default (SF Pro / Inter, like the body: one typeface across the site)"
      },
      "body": {
        "$type": "fontFamily",
        "$value": "{font.family.sans}",
        "$description": "Captions, dates, descriptions, body copy"
      },
      "proximity": {
        "$type": "fontFamily",
        "$value": "{font.family.flex}",
        "$description": "Words that grow heavier near the cursor (About page)"
      },
      "diagram": {
        "$type": "fontFamily",
        "$value": [
          "Myriad Pro",
          "Source Sans 3",
          "sans-serif"
        ],
        "$description": "Hand-built diagrams, matched to the Myriad lettering in the project's exported diagram images"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400,
        "$description": "Default text and big titles"
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500,
        "$description": "Labels and active filters"
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600,
        "$description": "Card titles"
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700,
        "$description": "Subtitles and small headings"
      },
      "h1": {
        "$type": "fontWeight",
        "$value": 700,
        "$description": "Hero / H1"
      },
      "h2": {
        "$type": "fontWeight",
        "$value": 650,
        "$description": "Section / H2: between semibold and bold (the sans is variable)"
      },
      "h3": {
        "$type": "fontWeight",
        "$value": 600,
        "$description": "Subheading / H3"
      },
      "body": {
        "$type": "fontWeight",
        "$value": 400,
        "$description": "Body text"
      },
      "nav": {
        "$type": "fontWeight",
        "$value": 500,
        "$description": "Buttons / nav"
      },
      "caption": {
        "$type": "fontWeight",
        "$value": 400,
        "$description": "Captions / small"
      }
    },
    "size": {
      "2xs": {
        "$type": "dimension",
        "$value": "11px",
        "$description": "Base step"
      },
      "xs": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "Base step"
      },
      "sm": {
        "$type": "dimension",
        "$value": "13px",
        "$description": "Base step"
      },
      "md": {
        "$type": "dimension",
        "$value": "14px",
        "$description": "Base step"
      },
      "base": {
        "$type": "dimension",
        "$value": "15px",
        "$description": "Base step"
      },
      "lg": {
        "$type": "dimension",
        "$value": "17px",
        "$description": "Base step"
      },
      "xl": {
        "$type": "dimension",
        "$value": "20px",
        "$description": "Base step"
      }
    }
  },
  "text": {
    "micro": {
      "$type": "dimension",
      "$value": "{text.scale.caption}",
      "$description": "Tiny labels under a details row"
    },
    "meta": {
      "$type": "dimension",
      "$value": "{text.scale.caption}",
      "$description": "Dates, tags, footer, captions under media"
    },
    "ui": {
      "$type": "dimension",
      "$value": "{text.scale.nav}",
      "$description": "Filters, small headings, form labels"
    },
    "body-sm": {
      "$type": "dimension",
      "$value": "{text.scale.nav}",
      "$description": "Summaries and secondary paragraphs"
    },
    "body": {
      "$type": "dimension",
      "$value": "{text.scale.body}",
      "$description": "Reading text"
    },
    "body-lg": {
      "$type": "dimension",
      "$value": "{text.scale.body}",
      "$description": "Headings inside an article"
    },
    "heading-sm": {
      "$type": "dimension",
      "$value": "{text.scale.h3}",
      "$description": "Small fixed headings"
    },
    "lead": {
      "$type": "dimension",
      "$value": "{text.scale.body}",
      "$description": "Fluid lead text and filter rows"
    },
    "small": {
      "$type": "dimension",
      "$value": "{text.scale.nav}",
      "$description": "Fluid small text"
    },
    "subtitle": {
      "$type": "dimension",
      "$value": "{text.scale.h3}",
      "$description": "Fluid subtitles under a page title"
    },
    "section-title": {
      "$type": "dimension",
      "$value": "{text.scale.h2}",
      "$description": "Home intro, year headings, post titles in a list"
    },
    "page-title": {
      "$type": "dimension",
      "$value": "{text.scale.h1}",
      "$description": "One per page: What I've done, Blog post, project title"
    },
    "home-intro": {
      "$type": "dimension",
      "$value": "min(clamp(20px, calc(16px + 0.8vw), 28px), 2.9cqw)",
      "$description": "Homepage intro: about 28px on desktop, regular weight, two lines; shrunk to the homepage grid so its long first line (~45 characters) never wraps beside the rail"
    },
    "intro-narrow": {
      "$type": "dimension",
      "$value": "clamp(18px, 5.4vw, 24px)",
      "$description": "Home intro on phones"
    },
    "hero": {
      "$type": "dimension",
      "$value": "{text.scale.h1}",
      "$description": "Big hero line"
    },
    "nav": {
      "$type": "dimension",
      "$value": "{text.scale.nav}",
      "$description": "Hero sub line and category links"
    },
    "footer": {
      "$type": "dimension",
      "$value": "{text.scale.nav}",
      "$description": "Footer text links"
    },
    "list": {
      "$type": "dimension",
      "$value": "{text.scale.body}",
      "$description": "Resume and project list rows"
    },
    "card": {
      "title": {
        "$type": "dimension",
        "$value": "clamp(18px, 5.8cqw, 32px)",
        "$description": "Timeline card title (scales with the card)"
      },
      "sub": {
        "$type": "dimension",
        "$value": "clamp(13.5px, 3.75cqw, 19px)",
        "$description": "Timeline card bold subtitle"
      },
      "body": {
        "$type": "dimension",
        "$value": "clamp(13px, 3.5cqw, 17px)",
        "$description": "Timeline card date, description, bullets"
      },
      "title-sm": {
        "$type": "dimension",
        "$value": "clamp(15px, 4.2cqw, 21px)",
        "$description": "Creative Side card title"
      },
      "meta-sm": {
        "$type": "dimension",
        "$value": "clamp(12px, 3cqw, 15px)",
        "$description": "Creative Side card date"
      }
    },
    "case": {
      "h1": {
        "$type": "dimension",
        "$value": "{text.meta}",
        "$description": "Case study h1: the small accent label that opens a section (Solution, Research, Conclusion)"
      },
      "h2": {
        "$type": "dimension",
        "$value": "{text.section-title}",
        "$description": "Case study h2: the big statement headline under the label (We let ourselves ideate freely…)"
      },
      "h3": {
        "$type": "dimension",
        "$value": "{text.subtitle}",
        "$description": "Case study h3: a sub-headline inside a section (Why we designed it this way, How it works)"
      },
      "column": {
        "$type": "dimension",
        "$value": "{text.body}",
        "$description": "Case study column title: same size as the text under it, set apart by colour"
      },
      "body": {
        "$type": "dimension",
        "$value": "{text.body}",
        "$description": "Case study reading text under any heading"
      }
    },
    "scale": {
      "h1": {
        "$type": "dimension",
        "$value": "clamp(32px, calc(24px + 2.2vw), 56px)",
        "$description": "Hero / H1: 32-40px on phones, up to 56px on desktop"
      },
      "h2": {
        "$type": "dimension",
        "$value": "clamp(24px, calc(20.3px + 1.08vw), 36px)",
        "$description": "Section / H2: 24-28px on phones, up to 36px on desktop"
      },
      "h3": {
        "$type": "dimension",
        "$value": "clamp(18px, calc(16.5px + 0.52vw), 24px)",
        "$description": "Subheading / H3: 18-20px on phones, up to 24px on desktop"
      },
      "body": {
        "$type": "dimension",
        "$value": "clamp(15px, calc(14.6px + 0.1vw), 16px)",
        "$description": "Body text: 15-16px"
      },
      "nav": {
        "$type": "dimension",
        "$value": "clamp(14px, calc(13.6px + 0.1vw), 15px)",
        "$description": "Buttons / nav: 14-15px"
      },
      "caption": {
        "$type": "dimension",
        "$value": "clamp(12px, calc(11.6px + 0.1vw), 13px)",
        "$description": "Captions / small: 12-13px"
      }
    },
    "case-title": {
      "$type": "dimension",
      "$value": "clamp(30px, calc(22px + 1.5vw), 44px)",
      "$description": "Case study page title: clearly the biggest thing on the page (about 44px on desktop)"
    },
    "case-statement": {
      "$type": "dimension",
      "$value": "clamp(24px, calc(19px + 0.9vw), 32px)",
      "$description": "Case study section statement (the question or claim under a small label), a step below the title"
    },
    "case-sub": {
      "$type": "dimension",
      "$value": "clamp(18px, calc(16px + 0.3vw), 20px)",
      "$description": "Case study sub-heading inside a section (\"Problem: …\"), 20px on desktop"
    },
    "case-read": {
      "$type": "dimension",
      "$value": "14px",
      "$description": "Case study reading text (the grey paragraphs and lists)"
    },
    "case-label": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Case study section labels (Overview, Solution…)"
    }
  },
  "leading": {
    "none": {
      "$type": "number",
      "$value": 1,
      "$description": "Single-line controls and icons"
    },
    "tight": {
      "$type": "number",
      "$value": 1.15,
      "$description": "Base step"
    },
    "snug": {
      "$type": "number",
      "$value": 1.3,
      "$description": "Base step"
    },
    "normal": {
      "$type": "number",
      "$value": 1.45,
      "$description": "Base step"
    },
    "relaxed": {
      "$type": "number",
      "$value": 1.6,
      "$description": "Base step"
    },
    "loose": {
      "$type": "number",
      "$value": 1.75,
      "$description": "Base step"
    },
    "title": {
      "$type": "number",
      "$value": "{leading.h1}",
      "$description": "Every title and subtitle"
    },
    "body": {
      "$type": "number",
      "$value": "{leading.body-text}",
      "$description": "Descriptions, captions, lists"
    },
    "prose": {
      "$type": "number",
      "$value": "{leading.relaxed}",
      "$description": "Long reading text (blog posts, project write-ups)"
    },
    "case-body": {
      "$type": "number",
      "$value": "{leading.body-text}",
      "$description": "Case study reading text: loose, so muted paragraphs stay easy to read"
    },
    "h1": {
      "$type": "number",
      "$value": 1.15,
      "$description": "Hero / H1"
    },
    "h2": {
      "$type": "number",
      "$value": 1.25,
      "$description": "Section / H2"
    },
    "h3": {
      "$type": "number",
      "$value": 1.35,
      "$description": "Subheading / H3"
    },
    "body-text": {
      "$type": "number",
      "$value": 1.55,
      "$description": "Body text (1.5-1.6)"
    },
    "nav": {
      "$type": "number",
      "$value": 1.1,
      "$description": "Buttons / nav"
    },
    "caption": {
      "$type": "number",
      "$value": 1.4,
      "$description": "Captions / small"
    }
  }
}
